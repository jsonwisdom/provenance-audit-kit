{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jsonwisdom:public-replay:v0.1:ssa:SSA_GATE1_RECEIPT_v0.1",
  "title": "SSA_GATE1_RECEIPT_v0.1",
  "description": "Offline Gate-1 verification receipt for an imported SSA public corpus. The receipt proves only the bounded V01-V08 evaluation over the supplied manifest and raw objects. H_G1 is intentionally excluded and must be computed from the exact canonical receipt bytes after serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_id",
    "corpus_id",
    "scope_id",
    "manifest_sha256",
    "manifest_rows_checked",
    "unique_raw_objects",
    "duplicate_observations",
    "missing_objects",
    "hash_failures",
    "length_failures",
    "malformed_rows",
    "check_results",
    "errors",
    "gate1_status",
    "promotion_authorized",
    "verification_mode",
    "network_used",
    "verified_at",
    "verifier_version"
  ],
  "properties": {
    "schema": {
      "const": "SSA_GATE1_RECEIPT_v0.1"
    },
    "protocol_id": {
      "const": "PUBLIC_REPLAY_PROTOCOL_v0.1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_rows_checked": {
      "type": "integer",
      "minimum": 0
    },
    "unique_raw_objects": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_observations": {
      "type": "integer",
      "minimum": 0
    },
    "missing_objects": {
      "type": "integer",
      "minimum": 0
    },
    "hash_failures": {
      "type": "integer",
      "minimum": 0
    },
    "length_failures": {
      "type": "integer",
      "minimum": 0
    },
    "malformed_rows": {
      "type": "integer",
      "minimum": 0
    },
    "check_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["V01", "V02", "V03", "V04", "V05", "V06", "V07", "V08"],
      "properties": {
        "V01": {
          "description": "Every manifest row resolves to an existing declared raw object.",
          "enum": ["PASS", "FAIL"]
        },
        "V02": {
          "description": "Each raw object's recomputed SHA-256 matches both its content-addressed identity and the manifest declaration.",
          "enum": ["PASS", "FAIL"]
        },
        "V03": {
          "description": "Each declared byte length equals the exact raw-object byte length.",
          "enum": ["PASS", "FAIL"]
        },
        "V04": {
          "description": "A declared SHA-256 resolves to exactly one content-addressed raw-object path within the supplied corpus.",
          "enum": ["PASS", "FAIL"]
        },
        "V05": {
          "description": "Duplicate observations, if present, reference the same byte-identical raw object and are not silently collapsed as observations.",
          "enum": ["PASS", "FAIL"]
        },
        "V06": {
          "description": "The supplied immutability evidence satisfies the protocol's no-overwrite / mutation-prohibited contract. If historical immutability cannot be established from the declared evidence boundary, V06 must FAIL rather than be inferred.",
          "enum": ["PASS", "FAIL"]
        },
        "V07": {
          "description": "Every manifest row is structurally valid under the declared manifest specification/schema.",
          "enum": ["PASS", "FAIL"]
        },
        "V08": {
          "description": "No manifest row references a missing or undeclared raw object.",
          "enum": ["PASS", "FAIL"]
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "code", "message"],
        "properties": {
          "check_id": {
            "enum": ["V01", "V02", "V03", "V04", "V05", "V06", "V07", "V08"]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "manifest_row": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate1_status": {
      "enum": ["PASS", "FAIL"]
    },
    "promotion_authorized": {
      "type": "boolean"
    },
    "verification_mode": {
      "const": "OFFLINE_IMPORTED_CORPUS"
    },
    "network_used": {
      "const": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate1_status": {
            "const": "PASS"
          }
        },
        "required": ["gate1_status"]
      },
      "then": {
        "properties": {
          "manifest_sha256": {
            "not": {
              "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
            }
          },
          "manifest_rows_checked": {
            "minimum": 1
          },
          "unique_raw_objects": {
            "minimum": 1
          },
          "missing_objects": {
            "const": 0
          },
          "hash_failures": {
            "const": 0
          },
          "length_failures": {
            "const": 0
          },
          "malformed_rows": {
            "const": 0
          },
          "errors": {
            "maxItems": 0
          },
          "promotion_authorized": {
            "const": true
          },
          "check_results": {
            "properties": {
              "V01": {"const": "PASS"},
              "V02": {"const": "PASS"},
              "V03": {"const": "PASS"},
              "V04": {"const": "PASS"},
              "V05": {"const": "PASS"},
              "V06": {"const": "PASS"},
              "V07": {"const": "PASS"},
              "V08": {"const": "PASS"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate1_status": {
            "const": "FAIL"
          }
        },
        "required": ["gate1_status"]
      },
      "then": {
        "properties": {
          "promotion_authorized": {
            "const": false
          },
          "errors": {
            "minItems": 1
          }
        },
        "anyOf": [
          {"properties": {"check_results": {"properties": {"V01": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V02": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V03": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V04": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V05": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V06": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V07": {"const": "FAIL"}}}}},
          {"properties": {"check_results": {"properties": {"V08": {"const": "FAIL"}}}}}
        ]
      }
    }
  ]
}
