{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:jsonwisdom:public-replay:v0.1:immutability:WORM_STORE_ATTESTATION_v0.1",
  "title":"WORM_STORE_ATTESTATION_v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","capture_id","H_manifest","prev_H_manifest","stored_at","storage_id","no_overwrite_attestation_ref","provider_id","object_version_id","retention_mode","retention_until","attestation_ref","signer_key_ref","signature_ref"],
  "properties":{
    "schema":{"const":"WORM_STORE_ATTESTATION_v0.1"},
    "capture_id":{"type":"string","minLength":1},
    "H_manifest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prev_H_manifest":{"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
    "stored_at":{"type":"string","format":"date-time"},
    "storage_id":{"type":"string","minLength":1},
    "no_overwrite_attestation_ref":{"type":"string","pattern":"^immutability/attestations/[0-9a-f]{64}\\.json$"},
    "provider_id":{"type":"string","minLength":1},
    "object_version_id":{"type":"string","minLength":1},
    "retention_mode":{"enum":["COMPLIANCE","GOVERNANCE","WRITE_ONCE"]},
    "retention_until":{"type":"string","format":"date-time"},
    "attestation_ref":{"type":"string","pattern":"^immutability/attestations/[0-9a-f]{64}\\.json$"},
    "signer_key_ref":{"type":"string","pattern":"^immutability/keys/[0-9a-f]{64}\\.[A-Za-z0-9._-]+$"},
    "signature_ref":{"type":"string","pattern":"^immutability/signatures/[0-9a-f]{64}\\.[A-Za-z0-9._-]+$"}
  }
}
