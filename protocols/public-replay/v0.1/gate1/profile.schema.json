{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jsonwisdom:public-replay:v0.1:gate1:profile",
  "title": "PUBLIC_REPLAY_GATE1_PROFILE_v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "profile_id",
    "scope_id",
    "corpus_id",
    "receipt_schema",
    "required_urls",
    "allowed_urls",
    "success_status_codes"
  ],
  "properties": {
    "protocol_id": {"const": "PUBLIC_REPLAY_PROTOCOL_v0.1"},
    "profile_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "receipt_schema": {"type": "string", "minLength": 1},
    "required_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "allowed_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "success_status_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 100, "maximum": 399}
    }
  },
  "allOf": [
    {
      "description": "Semantic validator must additionally enforce required_urls subset-of allowed_urls. JSON Schema draft 2020-12 cannot express arbitrary array subset membership directly without enumerating values."
    }
  ]
}
